# ---------------------------------------------------------------------------
# Mobile app (ค่าเหล่านี้ถูกฝังลงใน bundle — ใส่ได้เฉพาะค่าที่เปิดเผยได้)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth (client id ฝั่ง native เปิดเผยได้ ไม่ใช่ความลับ)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Supabase Edge Functions เท่านั้น (ห้ามขึ้นต้นด้วย EXPO_PUBLIC_ เด็ดขาด)
# ตั้งค่าด้วย: supabase secrets set --env-file supabase/.env
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — เลือกใช้ provider ใดก็ได้ ระบบสลับได้โดยไม่ต้องแก้โค้ดหน้าจอ
AI_TEXT_PROVIDER=anthropic          # anthropic | openai | gemini
AI_IMAGE_PROVIDER=openai            # openai | gemini
AI_SPEECH_PROVIDER=google           # google | openai
AI_VIDEO_PROVIDER=shotstack         # shotstack | internal

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# Payment (Stripe หรือ Omise สำหรับตลาดไทย)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

# ความปลอดภัย
JOB_WORKER_SECRET=
