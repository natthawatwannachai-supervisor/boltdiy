{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": [
      "@remix-run/cloudflare",
      "vite/client",
      "@cloudflare/workers-types/2023-07-01",
      "@types/dom-speech-recognition",
      "electron"
    ],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ESNext",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    // vite takes care of building everything, not tsc
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx"
  ],

  /*
   * teacher-video-factory เป็นแอป Expo/React Native ที่มี tsconfig, dependency
   * และ target ของตัวเอง จึงต้องกันออกจาก program ของ Remix ที่นี่
   * ตรวจ type ของแอปนั้นด้วย `npm run typecheck` ภายในโฟลเดอร์ของมันเอง
   */
  "exclude": ["node_modules", "dist", "build", "teacher-video-factory"]
}
